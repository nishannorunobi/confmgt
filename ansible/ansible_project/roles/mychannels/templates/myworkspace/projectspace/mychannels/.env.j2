{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are mychannels' own #}
# ── RabbitMQ version ───────────────────────────────────────────────────────────
RABBITMQ_VERSION={{ mirror.RABBITMQ_VERSION }}
# the base image pinned by digest (CLAUDEWORK-5): an offline build never re-pulls a moved tag
RABBITMQ_DIGEST={{ mirror.RABBITMQ_DIGEST }}

# ── Ports ──────────────────────────────────────────────────────────────────────
RABBITMQ_AMQP_PORT={{ mirror.RABBITMQ_AMQP_PORT }}
RABBITMQ_MGMT_PORT={{ mirror.RABBITMQ_MGMT_PORT }}

# ── Auth (the user and vhost — the password lives in kms, see channel-agent/agent.conf) ──
RABBITMQ_USER={{ mirror.RABBITMQ_USER }}
RABBITMQ_VHOST={{ mirror.RABBITMQ_VHOST }}

# ── Clock ──────────────────────────────────────────────────────────────────────
TZ={{ mirror.TZ }}

# No secret here: the RabbitMQ password's kms address is in channel-agent/agent.conf — the
# channel-agent fetches it and starts RabbitMQ. See README.md "Where are the secrets?".

# KMS_MASTER_PASSWORD_DIR — where kms's master_password folder is on this PC (TESTSERVER-26). Mounted READ-ONLY into
# mychannels-rabbitmq: the channel-agent signs itself up from it when it has no kms login yet. Relative = to this folder.
KMS_MASTER_PASSWORD_DIR={{ mirror.KMS_MASTER_PASSWORD_DIR }}
