{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are the project's own #}
# dockerspace/.env — non-secret settings for docker compose and the host scripts.

# OPENBAO_IMAGE — the OpenBao image, pinned by digest: an offline start never pulls anything new.
#     openbao/openbao:2 = OpenBao v2.7.1 on 2026-10-01
OPENBAO_IMAGE={{ mirror.OPENBAO_IMAGE }}

# ── How kms unlocks itself at start (stories [1.6] KMS-23 · [1.6f] KMS-189) ──────────────────────

# KMS_UNSEAL_MODE — how kms unlocks itself at every start. Possible values:
#     static   (default)  a key file unlocks kms by itself — no shares to type
#     shamir              you type 2 of your 3 shares at every start
# Missing, empty or unknown → static, with a warning; kms is never stopped by this setting.
# Changing it: kms's next start switches the vault by itself; startup asks your shares once.
# A new method = a new file in kms-agent/seal_modes/ (then it is a possible value here too).
KMS_UNSEAL_MODE={{ mirror.KMS_UNSEAL_MODE }}

# KMS_STATIC_KEY_DIR — the folder of the static key (file static_unseal.key, 32 bytes, 600). Possible values:
#     (empty)  (default)  ~/.config/kms
#     <a folder path>     ~/… · /… · or relative to this folder (dockerspace/), as compose reads it
# Set (owner, 2026-10-16): mountspace/usb/… — next to the share files; git-ignored and NOT in the backup zip
# (the zip takes mountspace/data + backups only: the key never travels with the kms snapshot).
# Never in git, Plane, logs or the backup zip. Losing the key = losing the vault: keep a copy off this PC.
KMS_STATIC_KEY_DIR={{ mirror.KMS_STATIC_KEY_DIR }}

# KMS_SHARES_DIR — the folder of share_1 · share_2 · share_3 (init.sh writes them, unseal.sh / bootstrap.sh read them;
# empty / missing files → asked). KMS_MASTER_PASSWORD_DIR — the folder of master_password (the owner's kms password;
# kept EMPTY most of the time, filled only when needed — every script that needs it says so, with the path).
# Each kind in its own folder (KMS-215): a project can mount ONLY the password folder; the usb/ tree can later be an
# external disk mounted there. Possible values: (empty) → the static key's folder · ~/… · /… · relative to this folder
KMS_SHARES_DIR={{ mirror.KMS_SHARES_DIR }}
KMS_MASTER_PASSWORD_DIR={{ mirror.KMS_MASTER_PASSWORD_DIR }}

# KMS_STATIC_KEY_COPY_DIR — where every kms start keeps a COPY of the static key. Possible values:
#     (empty)  (default)  no copy is made — each start reminds you until a copy exists
#     <a folder path>     a folder OFF this PC's disk, e.g. a USB stick folder: when it is plugged in, the start
#                         copies the key there (checked, 600) and puts the key back from it if it is missing
KMS_STATIC_KEY_COPY_DIR={{ mirror.KMS_STATIC_KEY_COPY_DIR }}

# KMS_USB_BACKUP_DIR — where kms_backup/backup_usb.sh keeps the ENCRYPTED backups of the usb/ folder (static key ·
# shares · master_password; the passphrase = your kms password). Possible values:
#     (empty)  (default)  mountspace/backups_usb — outside mountspace/backups: the main backup zip never takes it
#     <a folder path>     ~/… · /… · or relative to this folder; e.g. a USB stick folder (never where the main zip goes)
KMS_USB_BACKUP_DIR={{ mirror.KMS_USB_BACKUP_DIR }}
