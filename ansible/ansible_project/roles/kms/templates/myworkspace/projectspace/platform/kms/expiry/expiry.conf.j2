# expiry.conf — kms's expiry settings (CONFMGT [8.4], the [8.1] pattern). Tracked in git: it holds NO secret.
# Written by confmgt at every deploy: inventories/<env>/myworkspace/projectspace/platform/kms/expiry/expiry.conf.yml
# ← shared/expiry.yml (the rule, once for every project). Change it there — a hand edit is overwritten.
#
# WARN_BEFORE_DAYS — a credential that expires within this many days is shown at startup / shutdown
# (⚠ + what to do now · ✗ expired + the fix); until then nothing is printed. Missing / not a number → 7 + a WARN.
WARN_BEFORE_DAYS={{ mirror.WARN_BEFORE_DAYS }}
#
# ROTATE_AFTER_DAYS — a 🔑 key (key_list.conf kind rotate) gets a new value this many days after its last change;
# secret_age.sh warns WARN_BEFORE_DAYS before that day (the rotation day). Missing / not a number → 90 + a WARN.
ROTATE_AFTER_DAYS={{ mirror.ROTATE_AFTER_DAYS }}
