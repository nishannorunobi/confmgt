{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are the project's own #}
# Ansible Agent — Configuration (no secret — this file is in git)
# A secret's value is its kms address — the agent fetches the real value itself when it starts
# (connect_external/kms/kms.py, its own kms login). kms elsewhere: KMS_URL=https://<kms-host>:<port>, every
# ${KMS_URL}/v1/kv/data/… line follows.
KMS_URL={{ mirror.KMS_URL }}
# SECRET_MGT — where the secret below comes from. Possible values:
#     kms     (the workspace today)  its kms address, fetched at start
#     local                          the real value written right here (no kms at all)
# Missing / empty → local · unknown → local, with a warning.
SECRET_MGT={{ mirror.SECRET_MGT }}
# every secret keeps its kms address in the "# kms:" comment right above it — the rotation (connect_external/kms/):
# transfer (values): ansible_transfer_kms2tempfile.sh / _local2tempfile_random_value.sh / _tempfile2local.sh /
#   _local2kms.sh / _comment2local_kmsurl.sh · config (SECRET_MGT only): ansible_config_secret_mgt_local.sh / _kms.sh
PORT={{ mirror.PORT }}
# RUN_TIMEOUT — seconds one playbook run may take before it is stopped. Missing / not a number → 1800, with a warning.
RUN_TIMEOUT={{ mirror.RUN_TIMEOUT }}
# ANSIBLE_SSH_KEY_SECRET — 32 random characters; the agent turns them into Ansible's SSH key (ed25519) in RAM.
# A new value = a new key (then put the new public key on the machines: bash show_public_key.sh).
# kms: ${KMS_URL}/v1/kv/data/confmgt/ansible
ANSIBLE_SSH_KEY_SECRET={{ mirror.ANSIBLE_SSH_KEY_SECRET }}
