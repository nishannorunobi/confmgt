{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are the project's own #}
# .env — Plane's settings. Tracked in git: it holds NO secret. A secret's value is its kms
# ADDRESS; the start script fetches the values (connect_external/kms/kms.py) into a RAM file
# and hands that file to docker compose. The address is kms as seen from THIS PC.
#   KEY=${KMS_URL}/v1/kv/data/<entry>            key inside the entry = KEY
#   KEY=${KMS_URL}/v1/kv/data/<entry>#OTHER_KEY  the entry names it differently
# A new secret: bash connect_external/kms/add_new_secret_to_kms.sh   (asks name + value, writes the line)

# ── Plane version ─────────────────────────────────────────────────────────────
# kms's base is named ONCE (TESTSERVER-46) — as seen from THIS PC: kms elsewhere → KMS_URL=https://<kms-host>:<port>,
# every ${KMS_URL}/v1/kv/data/… line follows.
KMS_URL={{ mirror.KMS_URL }}
# SECRET_MGT — where the passwords below come from (TESTSERVER-67): kms = their kms addresses, fetched at start ·
# local = the real values written right here (no kms at all) · not set / empty → local
SECRET_MGT={{ mirror.SECRET_MGT }}
# every password keeps its kms address in the "# kms:" comment right above it — the rotation (connect_external/kms/):
# transfer (values): docs_transfer_kms2tempfile.sh / _local2tempfile_random_value.sh / _tempfile2local.sh /
#   _local2kms.sh / _comment2local_kmsurl.sh · config (SECRET_MGT only): docs_config_secret_mgt_local.sh / _kms.sh
PLANE_VERSION={{ mirror.PLANE_VERSION }}
# the three Plane images pinned by digest (CLAUDEWORK-5): an offline start never re-pulls. Bump = new version + its 3 digests.
PLANE_BACKEND_DIGEST={{ mirror.PLANE_BACKEND_DIGEST }}
PLANE_FRONTEND_DIGEST={{ mirror.PLANE_FRONTEND_DIGEST }}
PLANE_ADMIN_DIGEST={{ mirror.PLANE_ADMIN_DIGEST }}

# ── App ───────────────────────────────────────────────────────────────────────
# URL your browser uses to reach Plane (no trailing slash)
WEB_URL={{ mirror.WEB_URL }}
PLANE_PORT={{ mirror.PLANE_PORT }}
CORS_ALLOWED_ORIGINS={{ mirror.CORS_ALLOWED_ORIGINS }}
# Base URLs the web app uses to build links (e.g. "Get Started" → god-mode admin,
# and /spaces). Must include the :8080 port, else the instance config returns null
# and the web app falls back to a portless http://localhost/god-mode → ERR_CONNECTION_REFUSED.
APP_BASE_URL={{ mirror.APP_BASE_URL }}
ADMIN_BASE_URL={{ mirror.ADMIN_BASE_URL }}
SPACE_BASE_URL={{ mirror.SPACE_BASE_URL }}
DEBUG={{ mirror.DEBUG }}
DJANGO_SETTINGS_MODULE={{ mirror.DJANGO_SETTINGS_MODULE }}

# ── Django secret key — Plane's own, in kms (rotate: refresh_random_secrets_to_kms.sh SECRET_KEY — logs everyone out)
# kms: ${KMS_URL}/v1/kv/data/mydocs/plane
SECRET_KEY={{ mirror.SECRET_KEY }}

# ── Database (mypostgresql_db-container on my_docker_network) — the password is mypostgresql_db's, named DOCS_PASSWORD there
POSTGRES_USER={{ mirror.POSTGRES_USER }}
# kms: ${KMS_URL}/v1/kv/data/mypostgresql_db/mydocsdb#DOCS_PASSWORD
POSTGRES_PASSWORD={{ mirror.POSTGRES_PASSWORD }}
POSTGRES_DB={{ mirror.POSTGRES_DB }}
POSTGRES_HOST={{ mirror.POSTGRES_HOST }}
POSTGRES_PORT={{ mirror.POSTGRES_PORT }}
# DATABASE_URL is built by docker-compose.yml from the five lines above

# ── Redis (mycache-redis on mycache_mycache-net) — the password is mycache's
REDIS_HOST={{ mirror.REDIS_HOST }}
REDIS_PORT={{ mirror.REDIS_PORT }}
# kms: ${KMS_URL}/v1/kv/data/mycache/redis
REDIS_PASSWORD={{ mirror.REDIS_PASSWORD }}
# REDIS_URL is built by docker-compose.yml from the three lines above

# ── Object Storage (MinIO) — Plane's own root login, in kms; AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = the same two values (compose)
MINIO_ROOT_USER={{ mirror.MINIO_ROOT_USER }}
# kms: ${KMS_URL}/v1/kv/data/mydocs/plane
MINIO_ROOT_PASSWORD={{ mirror.MINIO_ROOT_PASSWORD }}
# Server-side endpoint (bucket check, background tasks) — must be the INTERNAL
# container address. Browser uploads use a presigned URL built from the request
# host (request.get_host()), which nginx proxies via the /uploads/ location.
AWS_S3_ENDPOINT_URL={{ mirror.AWS_S3_ENDPOINT_URL }}
AWS_S3_BUCKET_NAME={{ mirror.AWS_S3_BUCKET_NAME }}
FILE_SIZE_LIMIT={{ mirror.FILE_SIZE_LIMIT | default('5242880') }}
AWS_REGION={{ mirror.AWS_REGION }}
USE_MINIO={{ mirror.USE_MINIO }}
MINIO_ENDPOINT_SSL={{ mirror.MINIO_ENDPOINT_SSL }}

# ── Email (optional — leave blank to skip; a password would be a kms address) ─
EMAIL_BACKEND={{ mirror.EMAIL_BACKEND }}
EMAIL_HOST={{ mirror.EMAIL_HOST }}
EMAIL_HOST_USER={{ mirror.EMAIL_HOST_USER }}
EMAIL_HOST_PASSWORD={{ mirror.EMAIL_HOST_PASSWORD }}
EMAIL_PORT={{ mirror.EMAIL_PORT }}
EMAIL_USE_TLS={{ mirror.EMAIL_USE_TLS }}
EMAIL_FROM={{ mirror.EMAIL_FROM }}

# ── Auth ──────────────────────────────────────────────────────────────────────
ENABLE_SIGNUP={{ mirror.ENABLE_SIGNUP }}
ENABLE_EMAIL_PASSWORD={{ mirror.ENABLE_EMAIL_PASSWORD }}
ENABLE_MAGIC_LINK_LOGIN={{ mirror.ENABLE_MAGIC_LINK_LOGIN }}

# ── OAuth (leave blank to disable; a client secret would be a kms address) ───
GOOGLE_CLIENT_ID={{ mirror.GOOGLE_CLIENT_ID }}
GOOGLE_CLIENT_SECRET={{ mirror.GOOGLE_CLIENT_SECRET }}
GITHUB_CLIENT_ID={{ mirror.GITHUB_CLIENT_ID }}
GITHUB_CLIENT_SECRET={{ mirror.GITHUB_CLIENT_SECRET }}
GITHUB_APP_NAME={{ mirror.GITHUB_APP_NAME }}
GITLAB_HOST={{ mirror.GITLAB_HOST }}
GITLAB_CLIENT_ID={{ mirror.GITLAB_CLIENT_ID }}
GITLAB_CLIENT_SECRET={{ mirror.GITLAB_CLIENT_SECRET }}

# ── OpenAI (optional — for AI features; a key would be a kms address) ─────────
OPENAI_API_KEY={{ mirror.OPENAI_API_KEY }}
GPT_ENGINE={{ mirror.GPT_ENGINE }}

# ── RabbitMQ (mychannels-rabbitmq) — the password is mychannels', named RABBITMQ_PASS there
RABBITMQ_HOST={{ mirror.RABBITMQ_HOST }}
RABBITMQ_PORT={{ mirror.RABBITMQ_PORT }}
RABBITMQ_USER={{ mirror.RABBITMQ_USER }}
# kms: ${KMS_URL}/v1/kv/data/mychannels/rabbitmq#RABBITMQ_PASS
RABBITMQ_PASSWORD={{ mirror.RABBITMQ_PASSWORD }}
RABBITMQ_VHOST={{ mirror.RABBITMQ_VHOST }}
# AMQP_URL is built by docker-compose.yml from the four lines above

# KMS_MASTER_PASSWORD_DIR — where kms's master_password folder is on this PC (TESTSERVER-32): no kms login yet → the start
# signs mydocs up with the password in it, no question. Relative = to this folder. A path, no secret.
KMS_MASTER_PASSWORD_DIR={{ mirror.KMS_MASTER_PASSWORD_DIR }}

# Same clock as the host — container logs otherwise stamp UTC while host logs stamp EDT.
TZ={{ mirror.TZ }}
