{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are the project's own #}
# ccc/container/.env — settings of THE CCC container (no secret here: every secret's kms address is in
# ccc/agent/agent.conf). Tracked in git.

# ── The image ──────────────────────────────────────────────────────────────────
# the base image pinned by digest (CLAUDEWORK-5): an offline build never re-pulls a moved tag
PYTHON_IMAGE={{ mirror.PYTHON_IMAGE }}
PYTHON_DIGEST={{ mirror.PYTHON_DIGEST }}
# Ansible itself — pinned; the image tag follows it (ccc:<version>)
ANSIBLE_CORE_VERSION={{ mirror.ANSIBLE_CORE_VERSION }}

# ── Network ────────────────────────────────────────────────────────────────────
# the agent's API: the core (/health) + its abilities (deploy: /check /apply /playbooks /public-key /runs/last)
AGENT_HOST={{ mirror.AGENT_HOST }}
AGENT_PORT={{ mirror.AGENT_PORT }}

# ── Clock ──────────────────────────────────────────────────────────────────────
TZ={{ mirror.TZ }}

# ── Where the Ansible project comes from (CLAUDEWORK-270) ──────────────────────
# WORKSPACE_SOURCE — tried in this order, the first that works is used (shown in the start report: branch + commit).
# Possible values (comma-separated):
#     mounted   (default 1st) ccc/infra as it is on this machine, mounted read-only
#     clone     (default 2nd) the CCC's OWN clone of confmgt (WORKSPACE_CLONE_URL @ WORKSPACE_CLONE_BRANCH) in its
#               data volume — used when the mounted one is missing / broken (conflict markers, a failed syntax
#               check); it never touches your files
# Missing / empty → mounted,clone · unknown → skipped, with a warning.
WORKSPACE_SOURCE={{ mirror.WORKSPACE_SOURCE }}
# the clone: where from and which branch (the last tested one) — missing → github confmgt @ main
WORKSPACE_CLONE_URL={{ mirror.WORKSPACE_CLONE_URL }}
WORKSPACE_CLONE_BRANCH={{ mirror.WORKSPACE_CLONE_BRANCH }}

# LOG_DIR — where the agent's logs (calls.log · every playbook run's output) go on THIS machine. Possible values:
#     ../../mountspace/logs   (default) the workspace's mirror logs — the CCC inside ~/myworkspace (the PC)
#     /var/log/ccc            e.g. the CCC on its own server
# Relative = to this ccc/container/ folder · missing → the default · the folder is created at start when missing.
LOG_DIR={{ mirror.LOG_DIR }}

# KMS_MASTER_PASSWORD_DIR — where kms's master_password folder is on this machine. Mounted READ-ONLY into the CCC:
# the agent signs itself up from it when it has no kms login yet. Relative = to this ccc/container/ folder.
KMS_MASTER_PASSWORD_DIR={{ mirror.KMS_MASTER_PASSWORD_DIR }}
