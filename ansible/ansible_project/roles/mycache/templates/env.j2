{# rendered by Ansible (confmgt) from inventories/<env>/group_vars/mycache/ — the comments are mycache's own #}
# ── Redis version ──────────────────────────────────────────────────────────────
REDIS_VERSION={{ mycache_env.REDIS_VERSION }}
# the base image pinned by digest (CLAUDEWORK-5): an offline build never re-pulls a moved tag
REDIS_DIGEST={{ mycache_env.REDIS_DIGEST }}

# ── Network ────────────────────────────────────────────────────────────────────
REDIS_HOST={{ mycache_env.REDIS_HOST }}
REDIS_PORT={{ mycache_env.REDIS_PORT }}

# ── Clock ──────────────────────────────────────────────────────────────────────
TZ={{ mycache_env.TZ }}

# No secret here: the Redis password lives in kms — its address is in cache-agent/agent.conf
# (the cache-agent fetches it and starts Redis). See README.md "Where are the secrets?".

# KMS_MASTER_PASSWORD_DIR — where kms's master_password folder is on this PC (TESTSERVER-24). Mounted READ-ONLY into
# mycache-redis: the cache-agent signs itself up from it when it has no kms login yet. Relative = to this folder.
KMS_MASTER_PASSWORD_DIR={{ mycache_env.KMS_MASTER_PASSWORD_DIR }}
