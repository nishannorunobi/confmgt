{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are the project's own #}
# credentials.conf — the rules for mycache's issued credentials (CONFMGT [8.6]). Tracked in git: it holds NO secret.
# Written by confmgt at every deploy: inventories/<env>/myworkspace/…/cache-agent/issued_credentials/credentials.conf.yml
# ← shared/expiry.yml (the rules, once for every project). Change them there — a hand edit is overwritten.
#
# WARN_BEFORE_DAYS — a key due within this many days is shown at startup / shutdown (⚠ + what to do);
# until then nothing is printed. Missing / not a number → 7 + a WARN.
WARN_BEFORE_DAYS={{ mirror.WARN_BEFORE_DAYS }}
# ROTATE_AFTER_DAYS — the rotation rule (KMS-79): a password this many days after its last change is due for a new
# value — a REMINDER only, nothing stops. Missing / not a number → 90 + a WARN.
ROTATE_AFTER_DAYS={{ mirror.ROTATE_AFTER_DAYS }}
