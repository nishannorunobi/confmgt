{# rendered by Ansible (confmgt) from inventories/<env>/myworkspace/ (the mirror) + shared/ — the comments are the project's own #}
# expiry.conf — the log-agent's expiry settings (CONFMGT [8.1]). Tracked in git: it holds NO secret.
# Written by confmgt at every deploy: inventories/<env>/myworkspace/…/log-agent/expiry/expiry.conf.yml
# ← shared/expiry.yml (the rule, once for every project). Change it there — a hand edit is overwritten.
#
# WARN_BEFORE_DAYS — a credential that expires within this many days is shown at startup / shutdown
# (⚠ + what to do now · ✗ expired + the fix); until then nothing is printed. Missing / not a number → 7 + a WARN.
WARN_BEFORE_DAYS={{ mirror.WARN_BEFORE_DAYS }}
