# confmgt/ansible/dockerspace/.env — settings of the Ansible container (no secret here: the SSH key lives in kms,
# its address is in ansible-agent/agent.conf). Tracked in git.

# ── The image ──────────────────────────────────────────────────────────────────
# the base image pinned by digest (CLAUDEWORK-5): an offline build never re-pulls a moved tag
PYTHON_IMAGE=python:3-alpine
PYTHON_DIGEST=sha256:2e740b2c28a426e74f11396c05e38afb3191acced75045b8d62df573c1dc8ce8
# Ansible itself — pinned; the image tag follows it (confmgt-ansible:<version>)
ANSIBLE_CORE_VERSION=2.21.5

# ── Network ────────────────────────────────────────────────────────────────────
# the agent's API (ansible-agent): check / apply a playbook, the public key, the last run
AGENT_HOST=127.0.0.1
AGENT_PORT=8897

# ── Clock ──────────────────────────────────────────────────────────────────────
TZ=America/New_York

# LOG_DIR — where the agent's logs (every playbook run's output) go on THIS machine. Possible values:
#     ../../../../mountspace/logs   (default) the workspace's mirror logs — confmgt inside ~/myworkspace (the PC)
#     /var/log/confmgt              e.g. confmgt on its own server
# Relative = to this dockerspace/ folder · missing → the default · the folder is created at start when missing.
LOG_DIR=../../../../mountspace/logs

# KMS_MASTER_PASSWORD_DIR — where kms's master_password folder is on this machine (on its own server: e.g.
# /opt/confmgt-data/kms/master_password). Mounted READ-ONLY into
# confmgt-ansible: the ansible-agent signs itself up from it when it has no kms login yet. Relative = to this dockerspace/ folder.
KMS_MASTER_PASSWORD_DIR=../../../../mountspace/usb/myworkspace/projectspace/kms/master_password
